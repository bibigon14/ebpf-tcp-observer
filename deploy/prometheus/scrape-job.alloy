// Snippet for homelab Alloy config. Merge into monitoring/alloy-config
// alongside the existing bot/bridge/redis scrape pools.

prometheus.scrape "ebpf_observer" {
    targets = [{
        __address__ = "10.0.0.4:9100",
        instance    = "ebpf-observer-oci-sanjose",
    }]

    forward_to      = [prometheus.remote_write.homelab.receiver]
    job_name        = "ebpf-observer"
    scrape_interval = "15s"
    scrape_timeout  = "10s"
}
