[Unit]
Description=Trigger synthetic TCP retransmits for eBPF observer demo
Documentation=https://github.com/bibigon14/ebpf-tcp-observer
After=network-online.target

[Service]
Type=oneshot
# 192.0.2.1 is TEST-NET-1 - guaranteed blackhole; TCP will retry SYN.
# Timeout gives ~3-5 SYN retransmits per invocation.
ExecStart=/usr/bin/timeout 6 /usr/bin/curl -sS --connect-timeout 5 http://192.0.2.1:80/
# Non-zero exit is expected - the connection MUST fail. Do not treat as error.
SuccessExitStatus=7 28 124
StandardOutput=null
StandardError=null
